# Local secrets. GitHub Actions secrets live in repo Settings, not in files —
# this is only for running the scripts on your own machine (publish.py --send
# reads GMAIL_ADDRESS, GMAIL_APP_PASSWORD and RECIPIENT from the environment).
.env
*.env

# Generated issues. The Action uploads these as artifacts; never commit them.
issue_*.html
issue_*.gif
issue_*.eml

# Local scratch
build_issue.py
smoketest.html
*.tsv
urls.txt
final_links.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.venv-test/

# Build outputs. Regenerated every run and uploaded as artifacts.
candidates.json
issue.json
market.json
market_series.json
sent.ok
rejected/
prior/

# wrangler writes account id and cached auth state here
.wrangler/
